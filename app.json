{
  "expo": {
    "name": "DataReport IASA",
    "slug": "monitoreo-iasa",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "monitoreoiasa",
    "userInterfaceStyle": "dark",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#1E2923"
    },

    "assetBundlePatterns": ["**/*"],

    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "edu.usfx.iasa.monitoreo"
    },

    "android": {
      "adaptiveIcon": {
        "package": "edu.usfx.iasa.monitoreo",
        "versionCode": 1,
        "backgroundColor": "#1E2923",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },

    "plugins": ["expo-router", "expo-secure-store"],

    "experiments": {
      "typedRoutes": true
    }
  }
}
